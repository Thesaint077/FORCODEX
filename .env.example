APP_URL=http://localhost:3000
APP_MODE=sandbox
ALLOW_LOCAL_ADAPTERS=true
ENABLE_DEV_MAIL=true
DATABASE_URL=
LOCAL_DATABASE_PATH=.data/postgres
STORAGE_PATH=.data/assets
BOOKING_FEE_BPS=1500
FEE_VERSION=launch-v1
# No production collections adapter is implemented. Never put secrets in NEXT_PUBLIC variables.
# Production transactional email: set EMAIL_PROVIDER=resend after sender verification.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
