    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "lucide-react": "^0.563.0",
    "next": "16.4.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.1.18",
    "tar-fs": "^3.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
